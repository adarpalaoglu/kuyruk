# A list of the settings Kuyruk reads, with names only.
# Copy this file to .env and fill in the values. Never put real values in this
# file: it is shared on GitHub, while .env stays on your machine only.

# Name shown on the API documentation page. Optional (default: Kuyruk).
APP_NAME=

# Where the database is. Optional (default: a local SQLite file, kuyruk.db).
# For Postgres from compose.yaml, e.g.:
# postgresql+psycopg://kuyruk:<POSTGRES_PASSWORD>@localhost:5432/kuyruk
DATABASE_URL=

# Password of the Postgres database in compose.yaml. Secret.
POSTGRES_PASSWORD=

# Secret key that signs login passes. Secret. Required: Kuyruk won't start
# without it. At least 32 characters; make one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login pass stays valid, in minutes. Optional (default: 30).
ACCESS_TOKEN_MINUTES=

# Sign-up limits. Optional (defaults: username 3-30, password 8-128 characters).
USERNAME_MIN_LENGTH=
USERNAME_MAX_LENGTH=
PASSWORD_MIN_LENGTH=
PASSWORD_MAX_LENGTH=

# Job limits. Optional (defaults: 1-1000 texts per job, up to 2000 characters
# per text).
MIN_TEXTS_PER_JOB=
MAX_TEXTS_PER_JOB=
MAX_TEXT_CHARS=

# Job list paging. Optional (defaults: 50 per page, at most 200).
JOBS_PAGE_DEFAULT=
JOBS_PAGE_MAX=

# Longest Idempotency-Key and X-Request-ID accepted. Optional (defaults: 255
# and 64 characters).
IDEMPOTENCY_KEY_MAX_LENGTH=
REQUEST_ID_MAX_LENGTH=

# Largest request body in bytes. Optional (default: 26214400, i.e. 25 MB).
MAX_REQUEST_BYTES=

# Daily AI token budget per user, for llm jobs only. Optional (default:
# 200000). The day resets at midnight UTC.
DAILY_TOKEN_BUDGET=

# Token counting encoding. Optional (default: o200k_base, whose file is kept in
# app/data/; other encodings would need their own file).
TOKEN_ENCODING=

# Which AI the llm task uses: ollama or fake. Optional (default: fake).
AI_BACKEND=

# The real AI (Ollama on this Mac). Optional (defaults: http://localhost:11434,
# gemma4:e4b, temperature 0, seed 42, timeout 120 seconds). From inside Docker
# use http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=
OLLAMA_SEED=
OLLAMA_TIMEOUT_SECONDS=

# The fake AI. Optional (defaults: fixed wait of 1 second; replay file
# bench/data/ollama_times.csv; seed 42; a fixed Turkish answer; never fails;
# failures are temporary). Wait mode: fixed or replay. Fail every: 0 = never,
# 1 = every call, N = every Nth call. Fail kind: temporary or permanent.
FAKE_AI_WAIT_MODE=
FAKE_AI_WAIT_SECONDS=
FAKE_AI_REPLAY_FILE=
FAKE_AI_SEED=
FAKE_AI_ANSWER=
FAKE_AI_FAIL_EVERY=
FAKE_AI_FAIL_KIND=

# The worker. Optional (defaults: look for a new job every 1 second; 4 texts at
# once; 3 tries per text with waits of 1 s then 2 s (the first wait doubles);
# stop a job after 10 texts fail in a row; heartbeat every 5 seconds; after a
# stop signal wait at most 8 seconds for texts still with the AI).
WORKER_POLL_SECONDS=
TEXTS_AT_ONCE=
MAX_TRIES_PER_TEXT=
RETRY_FIRST_WAIT_SECONDS=
STOP_AFTER_FAILURES_IN_A_ROW=
HEARTBEAT_SECONDS=
SHUTDOWN_GRACE_SECONDS=
