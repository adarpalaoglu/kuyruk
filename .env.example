# A list of the settings Kuyruk reads, with names only.
# Copy this file to .env and fill in the values. Never put real values in this
# file: it is shared on GitHub, while .env stays on your machine only.
#
# DOCKER: DEMO OR REAL USE (D80)
# `docker compose up` with no .env runs a demo: compose.yaml fills in public,
# demo-only values (DEMO_MODE=true, the fake AI replaying waiting times,
# HEARTBEAT_SECONDS=1, STALE_AFTER_SECONDS=5, a demo POSTGRES_PASSWORD and a
# demo JWT_SECRET). Kuyruk refuses the demo JWT_SECRET unless DEMO_MODE=true.
# For real use, set at least these in .env (anything in .env wins over the
# demo values):
#   JWT_SECRET=<a real secret, see below>
#   POSTGRES_PASSWORD=<a real password>
#   DEMO_MODE=false
#   AI_BACKEND=ollama
#   HEARTBEAT_SECONDS=5
#   STALE_AFTER_SECONDS=30
# compose.yaml always sets DATABASE_URL (its `db` container) and OLLAMA_URL
# (http://host.docker.internal:11434) for its containers itself; the values of
# those two below are only for running Kuyruk directly on the Mac. Changing POSTGRES_PASSWORD after the database was first
# created needs a wipe (`docker compose down -v`), because Postgres keeps the
# password it started with.

# Name shown on the API documentation page. Optional (default: Kuyruk).
APP_NAME=

# Where the database is. Optional (default: a local SQLite file, kuyruk.db).
# For Postgres from compose.yaml, e.g.:
# postgresql+psycopg://kuyruk:<POSTGRES_PASSWORD>@localhost:5432/kuyruk
DATABASE_URL=

# Password of the Postgres database in compose.yaml. Secret. Use letters,
# digits, "-" and "_" only, because it also goes inside DATABASE_URL, where
# characters such as @ / : # would break the address.
POSTGRES_PASSWORD=

# Secret key that signs login passes. Secret. Required: Kuyruk won't start
# without it. At least 32 characters; make one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login pass stays valid, in minutes. Optional (default: 30).
ACCESS_TOKEN_MINUTES=

# Sign-up limits. Optional (defaults: username 3-30, password 8-128 characters).
USERNAME_MIN_LENGTH=
USERNAME_MAX_LENGTH=
PASSWORD_MIN_LENGTH=
PASSWORD_MAX_LENGTH=

# Job limits. Optional (defaults: 1-1000 texts per job, up to 2000 characters
# per text).
MIN_TEXTS_PER_JOB=
MAX_TEXTS_PER_JOB=
MAX_TEXT_CHARS=

# Job list paging. Optional (defaults: 50 per page, at most 200).
JOBS_PAGE_DEFAULT=
JOBS_PAGE_MAX=

# Longest Idempotency-Key and X-Request-ID accepted. Optional (defaults: 255
# and 64 characters).
IDEMPOTENCY_KEY_MAX_LENGTH=
REQUEST_ID_MAX_LENGTH=

# Largest request body in bytes. Optional (default: 26214400, i.e. 25 MB).
MAX_REQUEST_BYTES=

# Daily AI token budget per user, for llm jobs only. Optional (default:
# 200000). The day resets at midnight UTC.
DAILY_TOKEN_BUDGET=

# Token counting encoding. Optional (default: o200k_base, whose file is kept in
# app/data/; other encodings would need their own file).
TOKEN_ENCODING=

# Which AI the llm task uses: ollama or fake. Optional (default: fake).
AI_BACKEND=

# The real AI (Ollama on this Mac). Optional (defaults: http://localhost:11434,
# gemma4:e4b, temperature 0, seed 42, timeout 120 seconds). From inside Docker
# use http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=
OLLAMA_SEED=
OLLAMA_TIMEOUT_SECONDS=

# The fake AI. Optional (defaults: fixed wait of 1 second; replay file
# bench/data/ollama_times_at_4.csv, the real AI's times at 4 texts at once; seed 42; a fixed Turkish answer; never fails;
# failures are temporary). Wait mode: fixed or replay. Fail every: 0 = never,
# 1 = every call, N = every Nth call. Fail kind: temporary or permanent.
FAKE_AI_WAIT_MODE=
FAKE_AI_WAIT_SECONDS=
FAKE_AI_REPLAY_FILE=
FAKE_AI_SEED=
FAKE_AI_ANSWER=
FAKE_AI_FAIL_EVERY=
FAKE_AI_FAIL_KIND=

# The worker. Optional (defaults: look for a new job every 1 second; 4 texts at
# once; 3 tries per text with waits of 1 s then 2 s (the first wait doubles);
# stop a job after 10 texts fail in a row; heartbeat every 5 seconds; after a
# stop signal wait at most 8 seconds for texts still with the AI).
# For real use with Ollama: Ollama's own parallel setting (OLLAMA_NUM_PARALLEL,
# set on the Mac with `launchctl setenv OLLAMA_NUM_PARALLEL 4` and an Ollama
# restart, not in this file) must be at least TEXTS_AT_ONCE, otherwise the
# worker's texts just queue inside Ollama. Even then, Ollama 0.40.15 runs
# gemma4:e4b with its MLX engine, which answers one request at a time whatever
# the setting (D88), so on this setup more texts at once doesn't make jobs
# faster.
WORKER_POLL_SECONDS=
TEXTS_AT_ONCE=
MAX_TRIES_PER_TEXT=
RETRY_FIRST_WAIT_SECONDS=
STOP_AFTER_FAILURES_IN_A_ROW=
HEARTBEAT_SECONDS=
SHUTDOWN_GRACE_SECONDS=

# Crash recovery. Optional (defaults: a running job with no heartbeat for 30
# seconds is stuck and may be taken over by another worker; must be bigger
# than HEARTBEAT_SECONDS; a job may be taken over at most 3 times, then fails).
STALE_AFTER_SECONDS=
MAX_CRASH_COUNT=

# Live progress streams (GET /jobs/{ticket}/events). Optional (defaults: look at
# the job every 0.5 seconds; send a keep-alive line after 15 quiet seconds).
EVENTS_POLL_SECONDS=
EVENTS_KEEPALIVE_SECONDS=

# Demo mode: true switches on POST /demo/crash-worker (cause a worker crash on
# purpose to watch the recovery) and allows the public demo JWT_SECRET.
# Optional (default: false; compose.yaml makes it true unless set here).
DEMO_MODE=

# The worker's "I'm alive" file, for Docker's health check
# (`python -m app.worker --check-alive`). Optional (defaults: no file; healthy
# while the file is younger than 30 seconds). compose.yaml sets the file.
WORKER_ALIVE_FILE=
WORKER_ALIVE_MAX_AGE_SECONDS=

# Experiment E1 only (spec 9.1): true switches on the experiment addresses under
# /experiments/e1/, which freeze the API on purpose. Never together with
# DEMO_MODE (Kuyruk refuses to start). Optional (defaults: false; a slow step
# may wait at most 10 seconds).
EXPERIMENTS_ENABLED=
E1_MAX_WAIT_SECONDS=
